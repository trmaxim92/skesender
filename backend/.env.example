APP_NAME=SkySender
# Local only. Production: DEBUG=false (refuses weak SECRET_KEY / demo seed password).
DEBUG=true
SECRET_KEY=change-me
DATABASE_URL=postgresql+asyncpg://orderelite:orderelite@127.0.0.1:5433/orderelite
# Local demo TTL (7d). Production: shorter (e.g. 480–1440) + rotate SECRET_KEY on incident.
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_ADMIN_EMAIL=admin@order-elite.local
SEED_ADMIN_PASSWORD=demo
SEED_ADMIN_NAME=Admin
SEED_MAX_BOT_TOKEN=
MAX_API_BASE=https://platform-api2.max.ru
# Local only. Production: MAX_API_VERIFY_SSL=true (Minцифры cert or system CA).
MAX_API_VERIFY_SSL=false
MAX_PERSONAL_DATA_DIR=./data/max_personal
TELEGRAM_API_ID=26368063
TELEGRAM_API_HASH=e16c6d63c89cf3a8bc15d6f6b118e55b
TELEGRAM_USER_DATA_DIR=./data/telegram_user
# Bot API + MTProto proxy (EU SOCKS or local WARP): socks5://127.0.0.1:40000
TELEGRAM_PROXY=
# Empty = single-worker (in-memory hub). Set for multi uvicorn workers / replicas:
# REDIS_URL=redis://127.0.0.1:6379/0
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:admin@skysender.local
# With Redis: WS/widget fan-out via pub/sub; only one leader runs pollers/mailing/outbox.
# Example: uvicorn app.main:app --workers 2  (requires REDIS_URL)

# --- production checklist ---
# DEBUG=false
# SECRET_KEY=<random ≥24 chars>
# SEED_ADMIN_PASSWORD=<strong, unique>
# MAX_API_VERIFY_SSL=true
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
# REDIS_URL=redis://127.0.0.1:6379/0
